{
  "name": "@syncpty/host-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Host agent for SyncPTY",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "syncpty": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
